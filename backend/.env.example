# Copy this file to ".env" and fill in your own values. Never commit ".env".

# PostgreSQL connection string (SQLAlchemy + psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://sdp_user:CHANGE_ME@localhost:5432/sdp_portal

# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# Secret used to sign login tokens (JWT). Generate your own random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where uploaded supporting documents are stored (relative to backend/, or an absolute path)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
