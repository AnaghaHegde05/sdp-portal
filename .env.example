# Docker Compose settings. Copy this file to ".env" (never commit ".env"), or run:
#   powershell -ExecutionPolicy Bypass -File scripts\setup-env.ps1
# which creates .env with freshly generated random secrets.

# --- PostgreSQL (container) ---
POSTGRES_USER=sdp_user
POSTGRES_DB=sdp_portal
# Use letters and digits only (it is embedded in the database URL, so special characters would need URL-encoding).
POSTGRES_PASSWORD=CHANGE_ME_letters_and_digits_only

# --- Backend ---
# Signs login tokens. Must be random and at least 32 characters; the placeholder is rejected on purpose.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=5
# Maximum number of files per application (the one place this limit is set; the portal reads it from the API)
MAX_FILES_PER_APPLICATION=5
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ports published on your PC ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Frontend ---
# The address the BROWSER uses to reach the backend (host-published port, not the Docker service name).
# It is compiled into the frontend at build time: after changing it run `docker compose up --build`.
# If you change BACKEND_PORT, change the port here too.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
